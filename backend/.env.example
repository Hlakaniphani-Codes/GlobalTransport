NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://username:password@database-host:5432/global_ride_transport
JWT_SECRET=replace-with-at-least-32-random-characters
# Local development automatically allows localhost and private-LAN web origins.
# In production, set the exact deployed admin origin(s), comma-separated.
CORS_ORIGINS=
DATABASE_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
STATEMENT_TIMEOUT_MS=15000
IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
SLOW_QUERY_MS=200
REQUEST_TIMEOUT_MS=30000
METRICS_TOKEN=
SENTRY_DSN=
TRIP_START_WINDOW_MINUTES=90
OVERDUE_GRACE_MINUTES=30
AUTO_MISS_AFTER_MINUTES=60
LATE_WITHDRAW_HOURS=12
UNASSIGNED_ALERT_HOURS=3
REQUEST_EXPIRE_GRACE_MINUTES=15
CHANGE_CANCEL_EXEMPT_HOURS=24
NO_SHOW_WAIT_MINUTES=5
LATE_CANCELLATION_HOURS=2
ETA_STALE_MINUTES=15
EXPO_ACCESS_TOKEN=
SMS_PROVIDER=none
BULKSMS_USERNAME=
BULKSMS_PASSWORD=
CLICKATELL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OFFER_SMS_FALLBACK_SECONDS=120
TRIP_REMINDER_MINUTES=60
REDIS_URL=
WORKER_BATCH_SIZE=200
NOTIFICATION_RETENTION_DAYS=90
LOADTEST_ALLOW=false
LOADTEST_DATABASE_URL=
LOADTEST_PASSWORD=
LOADTEST_BASE_URL=
LOADTEST_ENVIRONMENT=
LOADTEST_ADMIN_USER_ID=
LOADTEST_ADMIN_EMAIL=
LOADTEST_ADMIN_PASSWORD=
LOADTEST_ADMIN_CREDENTIALS=
LOADTEST_PASSENGER_TOKEN_COUNT=1000
LOADTEST_DRIVER_TOKEN_COUNT=150
